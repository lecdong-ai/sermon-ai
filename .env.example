# ─── 필수 ───
# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Supabase 프로젝트 URL (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (server-side only, RLS 우회용)
SUPABASE_SERVICE_ROLE_KEY=

# ─── 선택 ───
# 카카오톡 공유 SDK 사용 (https://developers.kakao.com/)
NEXT_PUBLIC_KAKAO_KEY=

# ─── 결제 (Toss Payments) ───
# 토스페이먼츠 대시보드 (https://dashboard.tosspayments.com)에서 발급
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 토스 웹훅 시크릿 (선택, 웹훅 보안 강화)
TOSS_WEBHOOK_SECRET=

# ─── 회원가입 / 로그인 (필요시 Supabase Auth 설정) ───
# Supabase 콘솔 > Authentication > Providers에서
# Email, Kakao OAuth 등을 활성화하세요.
# 로그인 후 리다이렉트 URL에 추가:
#   http://localhost:3000/auth/callback
